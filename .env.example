# Runs end-to-end without paid APIs. Set to live when keys are ready.
OFFERLENS_MODE=demo
OFFERLENS_MODEL=openai:gpt-4.1-mini
OFFERLENS_MAX_REVISIONS=2
OFFERLENS_REQUIRE_APPROVAL=false
OFFERLENS_SEARCH_PROVIDER=fixture
OFFERLENS_CHECKPOINT_BACKEND=sqlite
OFFERLENS_DATA_DIR=.offerlens

OPENAI_API_KEY=
TAVILY_API_KEY=

# Optional tracing and evaluation
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=offerlens-agent
